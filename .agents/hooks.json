{
  "carelynx-prehook": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "./scripts/prehook.sh",
        "timeout": 5
      }
    ]
  },
  "carelynx-post-task-log-reminder": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "python -c \"import json; print(json.dumps({'injectSteps':[{'ephemeralMessage':'CARELYNX POST-TASK REMINDER'}]}))\"",
        "timeout": 5
      }
    ]
  },
  "carelynx-file-edit-gate": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import json; print(json.dumps({'decision':'allow','reason':'CARELYNX SAFETY REMINDER'}))\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
