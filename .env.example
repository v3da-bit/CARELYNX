# ─────────────────────────────────────────────────────────────
# CARELYNX environment template. Copy to `.env` (never commit .env).
# ─────────────────────────────────────────────────────────────

# ---------- API ----------
ENVIRONMENT=development
# PostgreSQL (docker-compose). If unset, the API falls back to a local SQLite file
# at apps/api/var/carelynx.db so the app stays runnable without Docker.
# DATABASE_URL=postgresql+psycopg://carelynx:carelynx@localhost:5432/carelynx
DATABASE_URL=

# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000

# Private document storage (local filesystem backend). Not web-served.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/storage
MAX_UPLOAD_MB=15

# ---------- AI / inference ----------
# rule_based     : deterministic local extractor (default, no network, dev/tests)
# openai_compat  : any OpenAI-compatible endpoint, e.g. vLLM on AMD ROCm (see infra/amd)
INFERENCE_PROVIDER=openai_compat
INFERENCE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
INFERENCE_MODEL=gemini-1.5-flash
INFERENCE_API_KEY=AIzaSyCTTClKOQuwYDciGo3iwrLtcF07h5tnoZU
INFERENCE_TIMEOUT_S=60
# Free-text label describing where inference actually ran. Must be truthful.
INFERENCE_HARDWARE_LABEL=gemini-cloud

# ---------- Safety thresholds ----------
# Page text-quality below this → fields from that page need review
SAFETY_MIN_PAGE_QUALITY=0.85
# Application-level confidence below this → NEEDS_REVIEW
SAFETY_MIN_FACT_CONFIDENCE=0.80

# ---------- Postgres container (docker-compose) ----------
POSTGRES_USER=carelynx
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=carelynx

# ---------- Web ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
