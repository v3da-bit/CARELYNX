# ─────────────────────────────────────────────────────────────────────────────
# CARELYNX — Vercel Frontend Environment Variables
# Set these in Vercel Dashboard → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# URL of the deployed Railway backend (no trailing slash)
# Use the rewrite proxy approach (recommended) — set this to /api/v1
# OR point directly to Railway if not using vercel.json rewrites:
NEXT_PUBLIC_API_BASE_URL=https://YOUR_RAILWAY_BACKEND_URL.railway.app/api/v1
