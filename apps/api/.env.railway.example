# ─────────────────────────────────────────────────────────────────────────────
# CARELYNX — Railway Backend Environment Variables
# Copy these into your Railway service's Variables panel (NOT committed to git)
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# Railway auto-injects DATABASE_URL when you add a Postgres plugin.
# It will look like: postgresql+psycopg://user:pass@host.railway.internal:5432/railway
# If using Neon, paste the psycopg3 connection string here:
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:5432/DBNAME

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set this to your Vercel frontend URL (no trailing slash)
CORS_ORIGINS=https://YOUR_APP.vercel.app

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/data/storage
MAX_UPLOAD_MB=10

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong 64-char random string: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX

# ── AI / Inference (Gemini) ───────────────────────────────────────────────────
INFERENCE_PROVIDER=openai_compat
INFERENCE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
INFERENCE_MODEL=gemini-1.5-flash
INFERENCE_API_KEY=YOUR_GEMINI_API_KEY
INFERENCE_TIMEOUT_S=60
INFERENCE_HARDWARE_LABEL=gemini-cloud

# ── Translation (optional) ────────────────────────────────────────────────────
GOOGLE_TRANSLATE_API_KEY=

# ── Safety Thresholds ─────────────────────────────────────────────────────────
SAFETY_MIN_PAGE_QUALITY=0.85
SAFETY_MIN_FACT_CONFIDENCE=0.80
